HOST=127.0.0.1
PORT=8899
# Independent PTY and Git Undo/Reapply are disabled by default.
# Enable only when these direct operations are required for a trusted local deployment.
CODEX_WEBUI_ENABLE_TERMINAL=false
CODEX_WEBUI_ENABLE_REVIEW_WRITE=false
# Optional additional file download roots, separated by ':' on Linux.
# Sensitive credentials remain excluded even inside these directories.
# CODEX_WEBUI_DOWNLOAD_ROOTS=/path/to/project:/path/to/exports
# Optional compatibility token for Basic/Bearer clients.
# CODEX_WEBUI_ACCESS_TOKEN=replace-with-a-long-random-secret

# Optional browser login password for LAN access. Localhost bypasses the login screen.
# When both password and token are unset on a LAN listener, the first browser creates a managed password.
# CODEX_WEBUI_PASSWORD=replace-with-a-long-random-password
# Optional path for the salted managed password credential.
# CODEX_WEBUI_AUTH_STORE=/path/to/.codex/codex-webui-auth.json
# Defaults to the repository directory.
CODEX_WEBUI_CWD=/path/to/your/project
# Undo/Reapply is restricted to this exact Git repository root by default.
CODEX_WEBUI_REVIEW_ROOT=/path/to/your/project
# Optional custom Codex state/auth locations.
# CODEX_HOME=/path/to/.codex
# CODEX_AUTH_PATH=/path/to/.codex/auth.json
# Auto-connect to an existing local Desktop/CLI App Server daemon. If none is
# running, auto keeps the standalone stdio behavior. Shared never starts a writer.
# CODEX_WEBUI_APP_SERVER_MODE=auto
# CODEX_WEBUI_APP_SERVER_SOCKET=/absolute/path/to/app-server-control.sock
# Use isolated explicitly for containers or a dedicated independent workspace.
# Optional browser binary for Playwright scripts.
PLAYWRIGHT_EXECUTABLE_PATH=/path/to/chrome-or-edge

# Optional ntfy push notifications on task completion.
# Set a topic to enable (subscribe to the same topic in the ntfy app or at https://ntfy.sh).
# CODEX_WEBUI_NTFY_TOPIC=my-codex-topic
# Optional custom ntfy server URL (defaults to https://ntfy.sh).
# CODEX_WEBUI_NTFY_URL=https://ntfy.sh

# Docker Compose settings (optional; host paths are intentionally generic).
# PUID=1000
# PGID=1000
# WEBUI_BIND_IP=127.0.0.1
# CODEX_HOME_HOST=/home/USERNAME/.codex
# CODEX_BIN=/home/USERNAME/.codex/packages/standalone/releases/VERSION/bin/codex
# PROJECT_HOST_PATH=/path/to/your/project
# The container uses /home/node/.codex and /workspace.

# Authentication defaults to the existing local/LAN behavior.
CODEX_WEBUI_AUTH_MODE=local
# Required only in cloudflare-access mode; HOST must remain loopback.
# Public origin is HTTPS with no trailing slash or path. Values below are placeholders.
# CODEX_WEBUI_PUBLIC_ORIGIN=https://YOUR_WEBUI_HOSTNAME
# CODEX_WEBUI_CF_ACCESS_TEAM_DOMAIN=YOUR_TEAM.cloudflareaccess.com
# CODEX_WEBUI_CF_ACCESS_AUD=YOUR_ACCESS_APPLICATION_AUD
# CODEX_WEBUI_CF_ACCESS_ALLOWED_EMAIL=YOUR_LOGIN_EMAIL
# Passwords, Basic/Bearer tokens and localhost do not bypass cloudflare-access mode.
